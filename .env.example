# Runtime
PORT=3000
NODE_ENV=development            # set to "production" when deploying (run `npm run build` first, then `npm start`)
APP_URL="http://localhost:3000" # public origin; used as the Socket.IO CORS origin
# TRUST_PROXY=true              # behind nginx/caddy/etc.: makes rate limiting use the real client IP

# Storage (SQLite + local uploads). Back this directory up.
# DATA_DIR="./data"

# Secrets -- REQUIRED in production (min 32 chars each; the server refuses to start otherwise).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# First run in production: creates the initial Super Admin + workspace (password min 12 chars).
# Ignored once any user exists. No demo data is created in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME="Administrator"
# ORG_NAME="My Company"

# Feature flags (defaults shown for production)
# ALLOW_REGISTRATION=false      # open self-signup; default true in development, false in production
# ENABLE_DOCS=false             # serve Swagger at /api/docs in production
# SEED_DEMO=false               # fake users/messages with a shared password; default true in development only
# ENABLE_DEMO_SWITCH=false      # passwordless "switch to any user" endpoint; development + SEED_DEMO only, never in production
